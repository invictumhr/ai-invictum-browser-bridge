{
  "manifest_version": 3,
  "name": "Invictum Browser Controller",
  "description": "Connects the user's active Chrome profile to Invictum Browser Bridge.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "activeTab",
    "tabs",
    "scripting",
    "webRequest",
    "webRequestAuthProvider",
    "debugger"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Invictum Browser Controller",
    "default_popup": "popup.html"
  }
}
